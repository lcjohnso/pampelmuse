#! /usr/bin/env python
__version__ = 0.5 ## 2011/02/24

import asciidata, numpy, os, pyfits, sys
import _my_profiles, read_config
from optparse import OptionParser, OptionGroup
from create_prm import CreatePrm
from ident_sources import IdentSources

DEFAULTPATH = "/home/kamann/prog/python/fitting/bin/init_cubefit.default"


cf = read_config.ReadConfig(DEFAULTPATH)
cf.read_keys()

parser = OptionParser(usage="%prog <IFU datacube> <sourcelist>",
                      version="%prog" + str(__version__))

psfgroup = OptionGroup(parser, "PSF options")
psfgroup.add_option("-p", "--psftype", dest="psftype", type="string",
                    default=cf.call_key("PSFTYPE"),
                    help="Analytical PSF profile used")
psfgroup.add_option("--psfpar1", dest="psfpar1", type="float",
                    default=cf.call_key("PSFPAR1"),
                    help="First shape parameter of PSF profile")
psfgroup.add_option("--psfpar2", dest="psfpar2", type="float",
                    default=cf.call_key("PSFPAR2"),
                    help="Second shape parameter of PSF profile")
psfgroup.add_option("--psfpar3", dest="psfpar3", type="float",
                    default=cf.call_key("PSFPAR3"),
                    help="Ellipticity of PSF profile")
psfgroup.add_option("--psfpar4", dest="psfpar4", type="float",
                    default=cf.call_key("PSFPAR4"),
                    help="Position angle of PSF profile")

posgroup = OptionGroup(parser,
                       "Options influencing estimation of source positions")
posgroup.add_option("--pospara", dest="pospara", type="float",
                    default=cf.call_key("POSPARA"),
                    help="Parameter A of coordinate transformation")
posgroup.add_option("--posparb", dest="posparb", type="float",
                    default=cf.call_key("POSPARB"),
                    help="Parameter B of coordinate transformation")
## posgroup.add_option("--posparc", dest="posparc", type="float",
##                     default=cf.call_key("POSPARC"),
##                     help="Parameter C of coordinate transformation")
## posgroup.add_option("--pospard", dest="pospard", type="float",
##                     default=cf.call_key("POSPARD"),
##                     help="Parameter D of coordinate transformation")
posgroup.add_option("-o", "--onlyoffsets", dest="oo", action="store_true",
                    help="Use selected positions only to determine an offset")

aphgroup = OptionGroup(parser, "Options influencing aperture photometry")
aphgroup.add_option("-a", "--aperrad", dest="aperrad", type="float",
                    default=cf.call_key("APERRAD"),
                    help="Radius used for aperture photometry [pixel]")
aphgroup.add_option("-c", "--apercorr", action="store_true", dest="apercorr",
                    help="Enable aperture correction")

selgroup = OptionGroup(parser, "Options influencing selection of sources")
selgroup.add_option("-r", "--rescut", dest="rescut", type='float',
                    default=cf.call_key("RESCUT"),
                    help="Expected confusion limit [mag]")
selgroup.add_option("-s", "--snrcut", dest="snrcut", type="float",
                    default=cf.call_key("SNRCUT"),
                    help="Minumum S/N estimate of a resolved source")
selgroup.add_option("-b", "--binrad", dest="binrad", type="float",
                    default=cf.call_key("BINRAD"),
                    help="Minimum distance between resolved sources [FWHM]")
selgroup.add_option("--unresolved", dest="unresolved", action="store_true",
                    help='Include contribution of unresolved sources')
selgroup.add_option("-u", "--unrescut", dest="unrescut", type="float",
                    default=cf.call_key("UNRESCUT"),
                    help="Magnitude range of sources in faint component")

gragroup = OptionGroup(parser, "Graphical output options")
gragroup.add_option("--hrescuts", dest="hrescuts", type="float",
                    default=cf.call_key("HRESCUTS"),
                    help="Cuts for displaying high resolution image")
gragroup.add_option("--ifucuts", dest="ifucuts", type="float",
                    default=cf.call_key("IFUCUTS"),
                    help="Cuts for displaying of IFU image")
gragroup.add_option("-v", "--verbose", dest="verbose", type="int",
                    default=int(cf.call_key("VERBOSE")),
                    help="Amount of information printed out on the screen")

srcgroup = OptionGroup(parser, "Options influencing how sourcelist is read")
srcgroup.add_option("-i", "--idcolumn", dest="idcolumn", type="int",
                    default=int(cf.call_key("IDCOLUMN")),
                    help="No. of column containing source IDs")
srcgroup.add_option("-x", "--xcolumn", dest="xcolumn", type="int",
                    default=int(cf.call_key("XCOLUMN")),
                    help="Number of column containing x-coordinates")
srcgroup.add_option("-y", "--ycolumn", dest="ycolumn", type="int",
                    default=int(cf.call_key("YCOLUMN")),
                    help="Number of column containing y-coordinates")
srcgroup.add_option("-m", "--mcolumn", dest="mcolumn", type="int",
                    default=int(cf.call_key("MCOLUMN")),
                    help="No. of column containing magnitudes")

parser.add_option_group(srcgroup)
parser.add_option_group(gragroup)
parser.add_option_group(psfgroup)
parser.add_option_group(posgroup)
parser.add_option_group(aphgroup)
parser.add_option_group(selgroup)


(options, args) = parser.parse_args()
if len(args) < 2:
    parser.print_help()
    sys.exit()

print ""
print "   ***  InitCubeFit, version %s   ***   " %str(__version__)
print ""

if options.psftype == "moffat":
    psfpars = [options.psfpar1,options.psfpar2,options.psfpar3,options.psfpar4]
elif options.psftype == "gauss":
    psfpars = [options.psfpar1,options.psfpar3,options.psfpar4]
else:
    raise IOError, "Unknown psf type: '%s'" %options.psftype 


headkeys = []

## Read sourcelist, write source information into arrays
sys.stdout.write('Reading source catalogue: %s ... ' %args[1])
sys.stdout.flush()
headkeys.append(("PHOTOIN", args[1], "File used for source identification"))

hstlist = asciidata.open(args[1])
id_hst  = hstlist[0].tonumpy()
x_hst   = hstlist[options.xcolumn].tonumpy()
y_hst   = hstlist[options.ycolumn].tonumpy()
mag_hst = hstlist[options.mcolumn].tonumpy()
print "DONE"


## Simulate a high resolution image using the information extracted
## from the sourcelist
sys.stdout.write('Simulating HST image... ')
sys.stdout.flush()

PSFSIZE = 25
MAGZ    = 30.

xsize = int(x_hst.max()) - int(x_hst.min())+ 2*PSFSIZE+1
ysize = int(y_hst.max()) - int(y_hst.min())+ 2*PSFSIZE+1
hstdata_full = numpy.zeros((ysize, xsize), dtype='float32')

for i in xrange(hstlist.nrows):
    x_c = PSFSIZE + x_hst[i] - int(x_hst[i])-0.5
    y_c = PSFSIZE + y_hst[i] - int(y_hst[i])-0.5

    xmin = int(x_hst[i] - int(x_hst.min()))
    ymin = int(y_hst[i] - int(y_hst.min()))

    psf = _my_profiles.Moffat((2*PSFSIZE,2*PSFSIZE), x_c, y_c, mag_hst[i]-MAGZ,
                              2.5, 3.0)
    
    hstdata_full[ymin:ymin+2*PSFSIZE,xmin:xmin+2*PSFSIZE] += psf.array

ex_l = int(x_hst.min()) - PSFSIZE-0.5
ex_r = int(x_hst.max()) + PSFSIZE+0.5
ex_t = int(y_hst.min()) - PSFSIZE-0.5
ex_b = int(y_hst.max()) + PSFSIZE+0.5
print "DONE"


## Read FITS-file containing IFU datacube, extract data and
## wavelength information
sys.stdout.write('Reading IFU data:\n   >>>%s ... ' %args[0])
sys.stdout.flush()
ifu_cube, ifu_head = pyfits.getdata(args[0], header=True)
ifu_root = args[0][:-9]

wl_step  = ifu_head['CDELT3']
wl_start = ifu_head['CRVAL3']
print "DONE"

if os.path.exists("%s.msk.fits" %ifu_root):
    sys.stdout.write('Found bad-pixel mask:\n   >>>%s.msk.fits\n' %ifu_root)
    sys.stdout.flush()
    ifu_mask = numpy.asarray(pyfits.getdata("%s.msk.fits" %ifu_root),
                             dtype="bool")
else:
    ifu_mask = None


headkeys.append(("APERRAD", options.aperrad,
                 "Radius used for aperture photometry [pixel]"))


tmp_resolv = (mag_hst<options.rescut)

## start gui, identify bright(est) stars and extract their spectra
identifier = IdentSources(ifu_cube, hstdata_full, id_hst[tmp_resolv],
                          x_hst[tmp_resolv], y_hst[tmp_resolv],
                          options.aperrad, imacuts=options.hrescuts,
                          ifucuts=options.ifucuts, wl_start=wl_start,
                          wl_step=wl_step, extent=(ex_l,ex_r,ex_b,ex_t),
                          ifumask=ifu_mask)
## identifier provides: *identifier.back - the background spectrum
##                      *identifier.spectra - spectra of identified sources
##                      *identifier.centers - pixel positions of identified
##                                            sources


if not options.unresolved:
    unrescut=None
else:
    unrescut = options.unrescut

## perform final source selection & create output-files
selector = CreatePrm(ifu_root, id_hst, x_hst, y_hst, mag_hst, wl_start, wl_step,
                     ifu_cube.shape[0], ifu_cube.shape[1:], options.psftype,
                     psfpars, headkeys, verbose=options.verbose)
selector.trans_coords(identifier.centers, [options.pospara, options.posparb,
                                           0., 0.],
                      only_offsets=options.oo)                     
selector.get_zpoint(identifier.spectra, options.apercorr, options.aperrad)
selector.create_sourcecat(options.rescut, identifier.back, options.snrcut,
                          unrescut, options.binrad, None)
selector.writeto()
